# Caddy: tự lấy chứng chỉ HTTPS (Let's Encrypt) cho {$DOMAIN}, chuyển tiếp vào container app.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Tệp tải lên qua admin tối đa 40 MB (khớp MAX_UPLOAD trong admin/server.py)
	request_body {
		max_size 50MB
	}

	reverse_proxy app:8080
}

# Tên miền có www → chuyển về tên miền chính (bỏ khối này nếu không dùng www)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
