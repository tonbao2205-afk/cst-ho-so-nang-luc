# Chép thành .env trên máy chủ rồi điền. KHÔNG đưa .env lên GitHub.

# Tên miền của trang (đã trỏ bản ghi A về IP máy chủ). Caddy tự cấp HTTPS.
DOMAIN=example.com

# Image do GitHub Actions build (ghcr.io/<tài khoản>/<tên repo>:latest)
IMAGE=ghcr.io/OWNER/REPO:latest

# Tài khoản admin tạo lần đầu (chỉ dùng khi chưa có mật khẩu; sau đó đổi trong admin > Tài khoản).
# Dùng mật khẩu mạnh: trang admin mở ra Internet.
CST_ADMIN_USER=quantri
CST_ADMIN_PASSWORD=

# 1 = cookie đăng nhập chỉ gửi qua HTTPS (để 1 khi chạy sau Caddy)
CST_COOKIE_SECURE=1
