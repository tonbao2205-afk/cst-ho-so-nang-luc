# Chạy tạm bằng IP (chưa có tên miền): chỉ HTTP cổng 80, KHÔNG có HTTPS.
# Vì mật khẩu sẽ đi qua mạng không mã hóa, trang admin và API bị chặn ở đây — chỉ phục vụ trang công khai.
# Khi có tên miền: trong .env đặt DOMAIN=<tên miền>, CADDYFILE=Caddyfile rồi `docker compose up -d`.
:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@admin path /admin /admin/* /api/*
	respond @admin "Trang quản trị chỉ mở khi đã có tên miền và HTTPS." 403

	reverse_proxy app:8080
}
